# 统一换行符：仓库内一律 LF；Windows 检出也保持 LF，避免与 CI（macOS/Linux）不一致
* text=auto

# 源码与文本文件强制 LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.plist text eol=lf

# 二进制资源不进行换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.p8 binary
*.p12 binary
*.mobileprovision binary
*.cer binary
